# ======================================================
# terraform.tfvars.example
# 이 파일을 복사해서 terraform.tfvars 로 사용하세요.
# terraform.tfvars 는 .gitignore 에 포함되어 있어 Git에 업로드되지 않습니다.
#
# 사용법:
#   cp terraform.tfvars.example terraform.tfvars
#   이후 terraform.tfvars 에서 public_key 값을 본인 키로 교체
# ======================================================

# [필수] SSH 퍼블릭 키 내용
# 아래 명령어로 확인: cat ~/.ssh/id_rsa.pub
#                또는 cat ~/.ssh/id_ed25519.pub
public_key = "ssh-rsa AAAAB3NzaC1yc2E... your-public-key-here"

# [선택] 아래 항목은 기본값이 있으므로 변경 시에만 작성

# key_name         = "ict-project-key"
# region           = "ap-northeast-2"
# desired_capacity = 1
# min_size         = 1
# max_size         = 8
# queue_length_per_instance_target = 2000
